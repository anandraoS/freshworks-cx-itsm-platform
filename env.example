# =====================================================================================
# env.example -- copy to `.env` for local use:   cp env.example .env
# (Named without a leading dot because the authoring environment's permission rules blocked writing
#  `.env.example`; rename it to `.env.example` if you prefer the conventional name.)
#
# ALL VALUES BELOW ARE DUMMY, LOCAL-DEVELOPMENT-ONLY PLACEHOLDERS. They are NOT secrets and
# MUST NOT be reused anywhere real. Replace every "CHANGE_ME" value before any shared or
# production-like deployment; production secrets belong in a secret manager, never in git.
# `.env` must be git-ignored; never commit it.
# =====================================================================================

# ---- PostgreSQL 16 (docker profile) -------------------------------------------------
POSTGRES_DB=cx
POSTGRES_USER=cx_app
POSTGRES_PASSWORD=CHANGE_ME_dummy_postgres_password
POSTGRES_PORT=5432

# ---- MongoDB 7 (AI / knowledge-base documents, docker profile) ----------------------
MONGO_INITDB_ROOT_USERNAME=cx_mongo
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_dummy_mongo_password
MONGO_PORT=27017

# ---- Redis 7 (cache) ----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_dummy_redis_password
REDIS_PORT=6379

# ---- RabbitMQ 3.13 (events) ---------------------------------------------------------
RABBITMQ_DEFAULT_USER=cx_app
RABBITMQ_DEFAULT_PASS=CHANGE_ME_dummy_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Service ports (see docs/API-CONTRACT.md) ---------------------------------------
GATEWAY_PORT=8080
CORE_PORT=8081
NOTIFICATION_PORT=8082
FRONTEND_PORT=5173
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---- Frontend -----------------------------------------------------------------------
# Browser-visible gateway URL, baked into the frontend bundle at build time.
VITE_API_BASE_URL=http://localhost:8080

# ---- Security -----------------------------------------------------------------------
# HS256 shared secret used by core-service, notification-service and gateway.
# Must be at least 32 characters. Placeholder only; generate your own, e.g.:  openssl rand -base64 48
CX_JWT_SECRET=CHANGE_ME_dummy_jwt_secret_at_least_32_chars_long_0000
# Grafana admin login for the local observability stack (dummy).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_dummy_grafana_password

# ---- AI assist ----------------------------------------------------------------------
# core-service reads AI_PROVIDER / AI_API_URL / AI_API_KEY first and falls back to the CX_AI_* aliases (application.yml);
# infra/docker-compose.yml passes the same resolution to the container, so set EITHER family (AI_* wins when both are set).
# "mock" = deterministic rule-based provider, no external calls, no key needed. "http" needs AI_API_URL (https) + AI_API_KEY.
AI_PROVIDER=mock
# Optional real-provider settings: leave EMPTY unless you deliberately enable a provider. Never commit a real key.
AI_API_URL=
AI_API_KEY=
# Aliases (kept for older .env files; ignored when the AI_* variable above is non-empty):
# CX_AI_PROVIDER=mock
# CX_AI_API_BASE_URL=
# CX_AI_API_KEY=

# ---- How these map to the Spring apps (docker profile) ------------------------------------
# compose derives, from the values above, the variables the apps actually read - identical names in core and notification:
#   CX_DB_URL / CX_DB_USER / CX_DB_PASSWORD        <- POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD
#   CX_RABBIT_HOST / _PORT / _USER / _PASSWORD     <- RABBITMQ_DEFAULT_USER / RABBITMQ_DEFAULT_PASS
#   CX_REDIS_HOST / _PORT / _PASSWORD (core only)  <- REDIS_PASSWORD
#   CX_MONGO_URI (core only)                       <- built from MONGO_INITDB_ROOT_USERNAME / _PASSWORD (URL-encode special characters)
#   CX_JWT_SECRET (core, notification, gateway)    <- CX_JWT_SECRET
# Running an app outside compose? Export those CX_* names yourself; the docker profiles have no fallback values for credentials.
# CX_MONGO_URI=mongodb://USER:PASSWORD@localhost:27017/cx?authSource=admin

# ---- Logging ------------------------------------------------------------------------
CX_LOG_LEVEL=INFO
ROOT_LOG_LEVEL=WARN

# ---- Observability endpoints --------------------------------------------------------
# Spring Boot Actuator paths scraped by Prometheus (docker network names).
CORE_PROMETHEUS_TARGET=core-service:8081
NOTIFICATION_PROMETHEUS_TARGET=notification-service:8082
GATEWAY_PROMETHEUS_TARGET=gateway:8090
PROMETHEUS_METRICS_PATH=/actuator/prometheus
GATEWAY_MANAGEMENT_PORT=8090
