  ORGANIZATION {
    uuid id PK
    varchar slug UK
    varchar timezone
    varchar business_hours_start
    varchar business_days
  }
  APP_USER {
    uuid id PK
    uuid tenant_id FK
    varchar email
    varchar roles
    boolean active
  }
  TICKET {
    uuid id PK
    uuid tenant_id FK
    bigint number
    varchar status
    varchar priority
    uuid requester_id FK
    uuid assignee_id FK
    timestamptz resolution_due_at
    varchar sla_status
    int escalation_level
    bigint version
  }
  TICKET_COMMENT {
    uuid id PK
    uuid tenant_id FK
    uuid ticket_id FK
    varchar visibility
    boolean ai_generated
  }
  SLA_POLICY {
    uuid id PK
    varchar priority
    int first_response_minutes
    int resolution_minutes
    varchar escalation_after_percent
  }
  WORKFLOW {
    uuid id PK
    int version
    boolean active
    varchar definition
  }
  OUTBOX_EVENT {
    uuid id PK
    varchar event_type
    varchar status
    int attempts
    timestamptz next_attempt_at
    timestamptz locked_until
  }
  IDEMPOTENCY_KEY {
    uuid id PK
    uuid user_id
    varchar idem_key
    varchar request_hash
  }
